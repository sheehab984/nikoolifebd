# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=nikoolife

# ─── Medusa Backend ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change_me
COOKIE_SECRET=change_me

STORE_CORS=https://nikoolife.co.uk
ADMIN_CORS=https://nikoolife.co.uk
AUTH_CORS=https://nikoolife.co.uk,https://api.nikoolife.co.uk

# Stripe secret key (from Stripe dashboard → Developers → API keys)
STRIPE_API_KEY=sk_live_...

# ─── Next.js Storefront ───────────────────────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.nikoolife.co.uk
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_BASE_URL=https://nikoolife.co.uk
NEXT_PUBLIC_DEFAULT_REGION=gb
NEXT_PUBLIC_STRIPE_KEY=pk_live_...

# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=change_me
